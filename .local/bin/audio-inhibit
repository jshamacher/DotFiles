#!/bin/bash

inhibitor_pid=""

cleanup() {
    if [[ -n "$inhibitor_pid" ]]; then
        kill "$inhibitor_pid" 2>/dev/null
        wait "$inhibitor_pid" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM

audio_running() {
    pw-dump | jq -e '
        any(.[];
          .type == "PipeWire:Interface:Node"
          and .info.props."media.class" == "Stream/Output/Audio"
          and .info.state == "running"
        )
    ' >/dev/null
}

while true; do
    if audio_running; then
        if [[ -z "$inhibitor_pid" ]] || ! kill -0 "$inhibitor_pid" 2>/dev/null; then
            systemd-inhibit \
                --what=idle \
                --who="audio-playback" \
                --why="Audio is playing" \
                sleep infinity &
            inhibitor_pid=$!
        fi
    else
        if [[ -n "$inhibitor_pid" ]]; then
            kill "$inhibitor_pid" 2>/dev/null
            wait "$inhibitor_pid" 2>/dev/null
            inhibitor_pid=""
        fi
    fi

    sleep 2
done