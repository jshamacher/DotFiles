#!/usr/bin/env bash

set -euo pipefail

SETUP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST=""
DRY_RUN=false
LIST=false

usage() {
    echo "Usage: ${0##*/} [--dry-run] [--list] [HOST]"
    echo "  --dry-run  Show commands without running them."
    echo "  --list     Summarize the resolved host configuration without running actions."
}

for arg in "$@"; do
    case "$arg" in
        --dry-run)
            DRY_RUN=true
            ;;
        --list)
            LIST=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $arg" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [[ -n "$HOST" || -z "$arg" ]]; then
                usage >&2
                exit 1
            fi
            HOST="$arg"
            ;;
    esac
done

HOST="${HOST:-$(hostname)}"

run() {
    if [[ "$DRY_RUN" == true ]]; then
        printf '[dry-run] Would run:'
        printf ' %q' "$@"
        printf '\n'
    else
        "$@"
    fi
}

HOST_FILE="$SETUP_DIR/hosts/$HOST"

if [[ ! -f "$HOST_FILE" ]]; then
    echo "No configuration found for host: $HOST" >&2
    exit 1
fi

PACKAGE_SETS=()
CONFIG_SETS=()
AUR_PACKAGES=()
# shellcheck source=/dev/null
source "$HOST_FILE"

packages=()

for set in "${PACKAGE_SETS[@]}"; do
    file="$SETUP_DIR/packages/$set"

    if [[ ! -f "$file" ]]; then
        echo "Package set does not exist: $set" >&2
        exit 1
    fi

    while IFS= read -r package || [[ -n "$package" ]]; do
        [[ -z "$package" ]] && continue
        [[ "$package" =~ ^[[:space:]]*# ]] && continue

        packages+=("$package")
    done < "$file"
done

config_scripts=()
for set in "${CONFIG_SETS[@]}"; do
    script="$SETUP_DIR/config/$set"

    if [[ ! -x "$script" ]]; then
        echo "Configuration set does not exist or is not executable: $set" >&2
        exit 1
    fi

    config_scripts+=("$script")
done

print_list() {
    local label="$1"
    shift
    echo "$label:"
    if (($#)); then
        printf '  %s\n' "$@"
    else
        echo "  (none)"
    fi
}

if [[ "$LIST" == true ]]; then
    echo "Host: $HOST"
    echo
    print_list "Package sets" "${PACKAGE_SETS[@]}"
    echo "Repository packages: ${#packages[@]}"
    echo
    print_list "AUR packages (declared only; installation is not implemented)" "${AUR_PACKAGES[@]}"
    echo
    print_list "Configuration sets" "${CONFIG_SETS[@]}"
    exit 0
fi

echo "Configuring host: $HOST"

if ((${#packages[@]})); then
    echo
    echo "Installing packages:"
    printf '  %s\n' "${packages[@]}"

    run sudo pacman -S --needed "${packages[@]}"
fi

for i in "${!CONFIG_SETS[@]}"; do
    echo
    echo "Applying configuration: ${CONFIG_SETS[$i]}"
    run "${config_scripts[$i]}"
done

echo
if [[ "$DRY_RUN" == true ]]; then
    echo "Dry run complete. No installation or configuration commands were executed."
else
    echo "Host configuration complete."
fi
