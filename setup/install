#!/usr/bin/env bash

set -euo pipefail

SETUP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST=""
DRY_RUN=false

usage() {
    echo "Usage: ${0##*/} [--dry-run] [HOST]"
}

for arg in "$@"; do
    case "$arg" in
        --dry-run)
            DRY_RUN=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $arg" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [[ -n "$HOST" || -z "$arg" ]]; then
                usage >&2
                exit 1
            fi
            HOST="$arg"
            ;;
    esac
done

HOST="${HOST:-$(hostname)}"

run() {
    if [[ "$DRY_RUN" == true ]]; then
        printf '[dry-run] Would run:'
        printf ' %q' "$@"
        printf '\n'
    else
        "$@"
    fi
}

HOST_FILE="$SETUP_DIR/hosts/$HOST"

if [[ ! -f "$HOST_FILE" ]]; then
    echo "No configuration found for host: $HOST" >&2
    exit 1
fi

PACKAGE_SETS=()
CONFIG_SETS=()
# shellcheck source=/dev/null
source "$HOST_FILE"

echo "Configuring host: $HOST"

packages=()

for set in "${PACKAGE_SETS[@]}"; do
    file="$SETUP_DIR/packages/$set"

    if [[ ! -f "$file" ]]; then
        echo "Package set does not exist: $set" >&2
        exit 1
    fi

    while IFS= read -r package; do
        [[ -z "$package" ]] && continue
        [[ "$package" =~ ^[[:space:]]*# ]] && continue

        packages+=("$package")
    done < "$file"
done

if ((${#packages[@]})); then
    echo
    echo "Installing packages:"
    printf '  %s\n' "${packages[@]}"

    run sudo pacman -S --needed "${packages[@]}"
fi

for set in "${CONFIG_SETS[@]}"; do
    script="$SETUP_DIR/config/$set"

    if [[ ! -x "$script" ]]; then
        echo "Configuration set does not exist or is not executable: $set" >&2
        exit 1
    fi

    echo
    echo "Applying configuration: $set"
    run "$script"
done

echo
if [[ "$DRY_RUN" == true ]]; then
    echo "Dry run complete. No installation or configuration commands were executed."
else
    echo "Host configuration complete."
fi
