#!/usr/bin/env bash

set -euo pipefail

SETUP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST=""
DRY_RUN=false
LIST=false

usage() {
    echo "Usage: ${0##*/} [--dry-run] [--list] [HOST]"
    echo "  --dry-run  Show commands without running them."
    echo "  --list     Summarize the resolved host configuration without running actions."
}

for arg in "$@"; do
    case "$arg" in
        --dry-run)
            DRY_RUN=true
            ;;
        --list)
            LIST=true
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "Unknown option: $arg" >&2
            usage >&2
            exit 1
            ;;
        *)
            if [[ -n "$HOST" || -z "$arg" ]]; then
                usage >&2
                exit 1
            fi
            HOST="$arg"
            ;;
    esac
done

HOST="${HOST:-$(hostname)}"

run() {
    if [[ "$DRY_RUN" == true ]]; then
        printf '[dry-run] Would run:'
        printf ' %q' "$@"
        printf '\n'
    else
        "$@"
    fi
}

HOST_FILE="$SETUP_DIR/hosts/$HOST"

if [[ ! -f "$HOST_FILE" ]]; then
    echo "No configuration found for host: $HOST" >&2
    exit 1
fi

PACKAGE_SETS=()
CONFIG_SETS=()
PACKAGES=()
AUR_PACKAGES=()
EXTRA_COMMANDS=()
AUR_HELPER="${AUR_HELPER:-yay}"
# shellcheck source=/dev/null
source "$HOST_FILE"

for set in "${PACKAGE_SETS[@]}"; do
    file="$SETUP_DIR/packages/$set"

    if [[ ! -f "$file" ]]; then
        echo "Package set does not exist: $set" >&2
        exit 1
    fi

    # shellcheck source=/dev/null
    source "$file"
done

config_scripts=()
for set in "${CONFIG_SETS[@]}"; do
    script="$SETUP_DIR/config/$set"

    if [[ ! -x "$script" ]]; then
        echo "Configuration set does not exist or is not executable: $set" >&2
        exit 1
    fi

    config_scripts+=("$script")
done

print_list() {
    local label="$1"
    shift
    echo "$label:"
    if (($#)); then
        printf '  %s\n' "$@"
    else
        echo "  (none)"
    fi
}

if [[ "$LIST" == true ]]; then
    echo "Host: $HOST"
    echo
    print_list "Package sets" "${PACKAGE_SETS[@]}"
    print_list "Repository packages (${#PACKAGES[@]})" "${PACKAGES[@]}"
    echo
    print_list "AUR packages" "${AUR_PACKAGES[@]}"
    echo
    print_list "Extra commands" "${EXTRA_COMMANDS[@]}"
    echo
    print_list "Configuration sets" "${CONFIG_SETS[@]}"
    exit 0
fi

if [[ "$DRY_RUN" == false ]] && ((${#AUR_PACKAGES[@]})); then
    if ! command -v "$AUR_HELPER" >/dev/null 2>&1; then
        echo "AUR helper not found: $AUR_HELPER. Install it before running this script." >&2
        exit 1
    fi
    if ((EUID == 0)); then
        echo "Run this script as a regular user; AUR packages cannot be built as root." >&2
        exit 1
    fi
fi

echo "Configuring host: $HOST"

if ((${#PACKAGES[@]})); then
    echo
    echo "Installing packages:"
    printf '  %s\n' "${PACKAGES[@]}"

    run sudo pacman -S --needed "${PACKAGES[@]}"
fi

if ((${#AUR_PACKAGES[@]})); then
    echo
    echo "Installing AUR packages:"
    printf '  %s\n' "${AUR_PACKAGES[@]}"

    run "$AUR_HELPER" -S --aur --needed "${AUR_PACKAGES[@]}"
fi

for command in "${EXTRA_COMMANDS[@]}"; do
    echo
    echo "Running extra command: $command"
    (
        cd "$SETUP_DIR"
        run bash -euo pipefail -c "$command"
    )
done

for i in "${!CONFIG_SETS[@]}"; do
    echo
    echo "Applying configuration: ${CONFIG_SETS[$i]}"
    run "${config_scripts[$i]}"
done

echo
if [[ "$DRY_RUN" == true ]]; then
    echo "Dry run complete. No installation or configuration commands were executed."
else
    echo "Host configuration complete."
fi
